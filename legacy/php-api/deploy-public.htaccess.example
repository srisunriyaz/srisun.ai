# Apache vhost/document-root rules for the built site + PHP API.
# Copy to .htaccess in the directory that holds the contents of dist/.
# The api/ folder sits beside it and keeps its own .htaccess.

RewriteEngine On

# 1. the API keeps its own front controller
RewriteRule ^api/ - [L]

# 2. real files and the prerendered <route>/index.html pages win
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. everything else (case study slugs, /admin) falls back to the app shell
RewriteRule ^ /index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(?:css|js|png|jpg|jpeg|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# never serve the env file or the uploads directory directly
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
